# Synapse HMS — copy to .env.local for development.
# Never commit real secrets. Never put these values in the Electron bundle.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL — clients must NOT connect here. Only the HMS server does.
DATABASE_URL=postgres://synapse:change-me@127.0.0.1:5432/synapse_hms

# Used to derive cookie signing / CSRF pepper. Generate with: openssl rand -hex 32
HMS_SECRET=replace-with-64-hex-chars-minimum-change-me-now

# Cookie flags. On a hospital LAN without TLS, keep COOKIE_SECURE=false.
COOKIE_SECURE=false
COOKIE_NAME=synapse_session

# Session lifetime
SESSION_TTL_HOURS=12
IDLE_TIMEOUT_MINUTES=45

# Initial bootstrap account (used only when no users exist)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeMe_Admin_1
INITIAL_ADMIN_FULL_NAME=System Administrator

# Backup directory on the server (not a client path)
BACKUP_DIR=./var/backups

# Bind address advertised to Electron clients
PUBLIC_APP_URL=http://127.0.0.1:3000

# Optional: allow CORS for a specific Electron origin. Empty = same-origin only.
CORS_ORIGIN=

# Rate limit for login
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15
